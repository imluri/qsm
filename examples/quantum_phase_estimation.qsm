-- Estimate the phase 1/2 of Z acting on its |1> eigenstate.
qbit q[3], target
creg result[3]
h q
x target

-- Controlled powers Z^(2^i): the first is Z, the others are identity.
for i = 0, 2 do
    cp(pi * 2^i) q[i], target
end

-- Inverse quantum Fourier transform on the counting register.
swap q[0], q[2]
for j = 0, 2 do
    for m = 0, j-1 do
        cp(-pi / 2^(j-m)) q[m], q[j]
    end
    h q[j]
end

measure q -> result
print "QPE output (expected 100, phase 4/8):", result
