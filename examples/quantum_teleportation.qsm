-- Teleport |+> from Alice to Bob using measurement feedback.
qbit alice, bob, aux
creg result[3]
h alice
h aux
cx aux, bob
cx alice, aux
h alice
measure alice -> result[0]
measure aux -> result[1]

if result[1] == 1 then
    x bob
end
if result[0] == 1 then
    z bob
end

-- Verify in the X basis: a successfully teleported |+> always yields zero.
h bob
measure bob -> result[2]
print "Bob verification bit (expected 0):", result[2]
print "Alice's measurements and Bob's verification:", result
