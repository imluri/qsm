-- Grover search for |1010>, with three amplification iterations.
qbit q[4]
creg answer[4]

function oracle()
    -- Convert |1010> to |1111>, flip its phase, then undo the conversion.
    x q[0], q[2]
    mcz q[0..2], q[3]
    x q[0], q[2]
end

function diffusion(n)
    for i = 0, n-1 do
        h q[i]
        x q[i]
    end
    mcz q[0..n-2], q[n-1]
    for i = 0, n-1 do
        x q[i]
        h q[i]
    end
end

h q
for iteration = 1, 3 do
    oracle()
    diffusion(4)
end

measure q -> answer
print "Grover output:", answer
